## Registers

# | Register | Usage     | Type    | Description                                      |
# | -------- | --------- | ------- | ------------------------------------------------ |
# | `$a0`    | input     | integer | year to check                                    |
# | `$v0`    | output    | boolean | input is leap year (`0` = `false`, `1` = `true`) |
# | `$t0-9`  | temporary | any     | used for temporary storage                       |

.globl is_leap_year

is_leap_year:
        # Remainder of division by 4
        li $t2, 4
        div $a0, $t2
        mfhi $t0
        bne $t0, $zero, return_false

        # Remainder when divisible by 100
        li $t2, 100
        div $a0, $t2
        mfhi $t0
        bne $t0, $zero, return_true
        
        # Remainder when divisible by 400
        li $t2, 400
        div $a0, $t2
        mfhi $t0
        beq $t0, $zero, return_true

return_false:
        li $v0, 0
        jr $ra        

return_true:
        li $v0, 1
        jr $ra
